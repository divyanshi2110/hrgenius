# Root .gitignore for HRGenius Enterprise HRMS

# Maven & Java Build Outputs
**/target/
**/*.class
**/*.jar
**/*.war
**/.mvn/wrapper/maven-wrapper.jar

# Node.js & Angular Dependencies & Build Outputs
**/node_modules/
**/.angular/
**/dist/
**/.cache/

# IDE & Editor Configurations
.idea/
*.iml
.vscode/
*.swp
*.swo
.project
.classpath
.settings/

# Operating System & Environment Files
.DS_Store
Thumbs.db
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Temporary Files
tmp/
temp/
.system_generated/
